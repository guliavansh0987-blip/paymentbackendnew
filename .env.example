# ZetPay Backend Environment Variables Example
NODE_ENV=production
PORT=5000
SITE_NAME=ZetPay

# Firebase Web App Config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=

# Firebase Admin Service Account
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web Push Notification
FCM_VAPID_KEY=

# Security Keys
JWT_SECRET=
JWT_EXPIRES_IN=30d
ADMIN_SECRET=
ENCRYPTION_KEY=
SMS_WEBHOOK_SECRET=

# URLs (Frontend CORS and redirects)
FRONTEND_URL=https://panel.zetpay.online,https://zetpay.online
STORE_URL=https://zetpay.online
WEBHOOK_URL=
TEST_GATEWAY_URL=

# Zap UPI Gateway Config
ZAP_API_URL=https://pay.zapupi.com/api
ZAP_KEY=

# Email & SMTP (Optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ZetPay Gateway

# NVIDIA AI Agent
NVIDIA_API_KEY=
NVIDIA_API_KEY_ZPPY=
NVIDIA_MODEL_ZPPX=deepseek-ai/deepseek-v4-pro
NVIDIA_FALLBACK_MODEL_ZPPX=deepseek-ai/deepseek-v4-flash
NVIDIA_MODEL_ZPPY=z-ai/glm-5.2
